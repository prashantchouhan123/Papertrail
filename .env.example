NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_PATH=/api/v1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=research_app
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_document_research_assistant
MYSQL_SSL=false
MYSQL_SSL_CA=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=ai-doc-research
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# AI calls are disabled until a provider is configured. Gemini use may incur charges.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
ENABLE_GEMINI=false

STORAGE_DRIVER=local
UPLOAD_DIR=./private-uploads
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=100
MAX_DOCUMENTS_PER_USER=20
MAX_STORAGE_BYTES_PER_USER=1000000000
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CHAT_REQUESTS_PER_MINUTE=10
MAX_AUTH_REQUESTS_PER_MINUTE=10
MAX_UPLOAD_REQUESTS_PER_MINUTE=10
TRUST_PROXY_HOPS=0

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
